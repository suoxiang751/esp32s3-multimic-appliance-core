+bool AudioService::WaitForAudioInputReady(uint32_t timeout_ms) {
+    EventBits_t bits = xEventGroupWaitBits(
+        event_group_,
+        AS_EVENT_AUDIO_INPUT_READY,
+        pdFALSE,
+        pdTRUE,
+        pdMS_TO_TICKS(timeout_ms));
+    return (bits & AS_EVENT_AUDIO_INPUT_READY) != 0;
+}
