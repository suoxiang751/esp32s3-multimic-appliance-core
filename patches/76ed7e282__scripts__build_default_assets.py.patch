+def read_nsnet_from_sdkconfig(sdkconfig_path):
+    """Read NSNet selection from sdkconfig; returns ['nsnet2'] when enabled."""
+    if not os.path.exists(sdkconfig_path):
+        return []
+    with io.open(sdkconfig_path, "r", encoding="utf-8") as f:
+        for line in f:
+            if 'CONFIG_SR_NSN_NSNET2=y' in line:
+                return ['nsnet2']
+    return []
+
+
+def get_nsnet_model_paths(model_names, esp_sr_model_path):
+    """Resolve NSNet model directories under nsnet_model/."""
+    valid_paths = []
+    for model_name in model_names:
+        nsnet_path = os.path.join(esp_sr_model_path, 'nsnet_model', model_name)
+        if os.path.exists(nsnet_path):
+            valid_paths.append(nsnet_path)
+        else:
+            print(f"Warning: NSNet model directory not found: {nsnet_path}")
+    return valid_paths
+
